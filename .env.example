# claude-attest — optional configuration.
# Capture works with none of these set; they enable anchoring and countersigning.

# Anchor backend: mock (offline, still signed) | notaryhash (BSV mainnet)
CLAUDE_ATTEST_ANCHOR=mock

# Subscribe at https://proofofprocess.ai to obtain these.
NOTARYHASH_API_KEY=
COUNTERSIGNER_URL=https://countersign.proofofprocess.ai
COUNTERSIGNER_API_KEY=

# Where state lives. Defaults to ~/.claude-attest
# CLAUDE_ATTEST_HOME=

# Write diagnostics to $CLAUDE_ATTEST_HOME/debug.log
# CLAUDE_ATTEST_DEBUG=1
